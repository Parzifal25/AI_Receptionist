{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/workflows",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/no-shows",
      "schedule": "*/15 * * * *"
    }
  ]
}
