# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of this deployment (used in the widget embed snippet and auth
# email redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SECRET — server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI ──────────────────────────────────────────────────────────────────────
# Provider: cloud (Groq → OpenRouter) | ollama | openai | anthropic | gemini | groq | mistral
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
# Required for every provider except ollama.
LLM_API_KEY=
# Optional override for OpenAI-compatible providers (self-hosted gateways).
LLM_BASE_URL=
# For LLM_PROVIDER=cloud, use both existing vendor-specific secret names.
# The fixed model order is documented in docs/CLOUD_LLM_REPORT.md.
GROQ_LLM_API_KEY=
OPENROUTER_LLM_API_KEY=

# Ollama (development default)
OLLAMA_BASE_URL=http://localhost:11434

# Per-request LLM timeout. A CPU-hosted Ollama model needs much longer than
# a hosted API: prompt eval + generation time scale with system-prompt size
# and CPU speed, not just model size. If chat turns are timing out (watch
# for "ollama request timed out" in logs), raise this before switching
# models. 120000 (2 min) is a safer floor for CPU-only Ollama hosts;
# hosted providers (anthropic/openai/gemini/groq/mistral) rarely need more
# than the 60000 default.
LLM_TIMEOUT_MS=60000

# Embeddings for semantic knowledge search: none | ollama
# "none" uses Postgres full-text search — fully functional, no extra setup.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=nomic-embed-text

# ── Calendar connections (OAuth apps) ───────────────────────────────────────
# Needed only if tenants will connect an external calendar from
# Dashboard → Settings. Until set, the Settings page shows a setup wizard
# with these exact steps instead of a connect button.
#
# Google: https://console.cloud.google.com/apis/credentials
#   1. Create an OAuth 2.0 Client ID (type "Web application").
#   2. Add <NEXT_PUBLIC_APP_URL>/api/oauth/google-calendar/callback as an
#      authorized redirect URI.
#   3. Enable the "Google Calendar API" on the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Outlook / Microsoft 365) — connect flow not built yet; the
# engine reads existing calendar_connections rows if you create them.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Outbound messaging ──────────────────────────────────────────────────────
# Delivery gateway for booking confirmations and reminders.
# "log" (default) writes deliveries to the application log — nothing reaches
# visitors until a real gateway (Twilio, WhatsApp Cloud, …) is wired in.
MESSAGING_PROVIDER=log

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Secret that authorizes cron routes (e.g. /api/cron/retention). On Vercel,
# set this and Vercel Cron sends it automatically as a Bearer token.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Voice gateway (services/voice-gateway) ──────────────────────────────────
# The gateway has its OWN configuration schema and fails closed at startup.
# Full table: services/voice-gateway/README.md. Local loop: docs/LOCAL_VOICE_LOOP.md.
#
# VOICE_GATEWAY_PUBLIC_WS_URL=ws://127.0.0.1:8787/media
# VOICE_STREAM_TOKEN_SECRET=      # >=32 chars: openssl rand -hex 32
# TELEPHONY_PROVIDER=fake         # fake | twilio
# VOICE_FAKE_WEBHOOK_SECRET=      # >=16 chars, with the fake provider
#
# Speech vendors. Default is the deterministic fake pair, which transcribes
# nothing and speaks nothing — the process runs end to end, but there is no
# real audio until a vendor is configured. Selecting one REQUIRES its key.
#
# VOICE_STT_PROVIDER=fake         # fake | sarvam | self-hosted
# VOICE_STT_API_KEY=
# VOICE_STT_MODE=transcribe       # transcribe | verbatim | translit | codemix
# VOICE_TTS_PROVIDER=fake         # fake | sarvam | self-hosted
# VOICE_TTS_API_KEY=
# VOICE_TTS_DEFAULT_VOICE=        # required with a real vendor; no default voice
#
# Selecting a vendor is not a quality claim: none has been run against its
# live endpoint from this repository (docs/KNOWN_LIMITATIONS.md).

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info

# Optional deployment-owned speech endpoints and tenant profiles (never public).
# VOICE_STT_BASE_URL=http://speech-inference:9000
# VOICE_TTS_BASE_URL=http://speech-inference:9000
# VOICE_STT_FALLBACK_BASE_URL=http://speech-inference:9000
# VOICE_TTS_FALLBACK_BASE_URL=http://speech-inference:9000
# VOICE_PROFILES_JSON={"tenant-uuid":{"indic-v1":{"sampleRate":8000,"stt":{"provider":"self-hosted","baseUrl":"http://speech-inference:9000"},"tts":{"provider":"self-hosted","baseUrl":"http://speech-inference:9000"}}}}
# Pipecat: exact trusted URL, also carried by HALO's signed media parameters.
# HALO_CONTROL_URL=wss://gateway.example/pipecat/control
# HALO_SPEECH_PROVIDER=sarvam     # fake must be selected explicitly for tests
# SARVAM_API_KEY=

# Outbound is opt-in, requires provisioned carrier numbers and explicit consent.
HALO_OUTBOUND_ENABLED=false
# HALO_OUTBOUND_GATEWAY_URL=https://gateway.example
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Invoke /api/cron/campaigns with CRON_SECRET; bounded, tenant-fair scheduling.
